# =====================================================================
# docker-compose.yml 이 참조하는 env 샘플
#
# 사용법:
#   cp .env.example .env
#   값 채우고 docker compose up
# =====================================================================

# ===== MariaDB ⚠️ production 에선 반드시 변경 =====
MARIADB_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MARIADB_DB_NAME=agent
MARIADB_DB_USER=agent
MARIADB_DB_PASSWORD=CHANGE_ME_strong_db_password

# ===== 모델 host 경로 (read-only volume 마운트됨) =====
# 안에 bge-m3/, gpt-oss-20b-GGUF/, meta-llama-3.1-8b-instruct-q4_k_m.gguf 가 있어야
MODELS_DIR=/service/models

# ===== 외부 노출 포트 (FastAPI) =====
SERVER_PORT=8443

# ===== CUDA / Image tag =====
# cu128 → host driver 535+ 호환 (default)
# cu130 → host driver 575+ 필요
# 셋이 서로 일치해야 함.
AI_CONSOLE_TAG=cu128
CUDA_VER=12.8.1
TORCH_CUDA=cu128

# ===== OpenAI (선택) =====
OPENAI_API_KEY=

# ===== Slack (선택) =====
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
